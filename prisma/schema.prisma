generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────── Enums ─────────

enum Role {
  CUSTOMER
  INVENTORY_OPERATOR
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVE
  RELEASE
  SALE
  RETURN
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

// ───────── Identity ─────────

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  role         Role     @default(CUSTOMER)
  passwordHash String?  @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart          Cart?
  orders        Order[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// ───────── Catalog ─────────

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("brands")
}

model Product {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String
  slug           String   @unique
  description    String   @default("")
  brandId        String   @map("brand_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  specs          Json     @default("{}")
  warrantyMonths Int      @default(24) @map("warranty_months")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String   @unique
  name       String
  attributes Json     @default("{}")
  priceMinor Int      @map("price_minor")
  currency   String   @default("EUR") @db.Char(3)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    InventoryItem?
  images       ProductImage[]
  cartItems    CartItem[]
  reservations StockReservation[]
  movements    InventoryMovement[]
  orderItems   OrderItem[]

  @@index([productId])
  @@index([priceMinor])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  secureUrl String   @map("secure_url")
  publicId  String   @unique @map("public_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([variantId])
  @@map("product_images")
}

// ───────── Inventory ─────────

model InventoryItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  variantId    String   @unique @map("variant_id") @db.Uuid
  onHand       Int      @default(0) @map("on_hand")
  reserved     Int      @default(0)
  reorderLevel Int      @default(5) @map("reorder_level")
  version      Int      @default(0)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model InventoryMovement {
  id            String       @id @default(uuid(7)) @db.Uuid
  variantId     String       @map("variant_id") @db.Uuid
  type          MovementType
  deltaOnHand   Int          @map("delta_on_hand")
  deltaReserved Int          @map("delta_reserved")
  reason        String?
  referenceType String?      @map("reference_type")
  referenceId   String?      @map("reference_id")
  actorId       String?      @map("actor_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // NULL references (manual operations) are never considered duplicates by Postgres
  @@unique([referenceType, referenceId, variantId, type])
  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ───────── Cart ─────────

model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ───────── Orders, reservations, payments ─────────

model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  orderNumber     String      @unique @map("order_number")
  userId          String      @map("user_id") @db.Uuid
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotalMinor   Int         @map("subtotal_minor")
  shippingMinor   Int         @default(0) @map("shipping_minor")
  totalMinor      Int         @map("total_minor")
  currency        String      @default("EUR") @db.Char(3)
  idempotencyKey  String      @map("idempotency_key")
  shippingAddress Json        @map("shipping_address")
  cancelReason    String?     @map("cancel_reason")
  paidAt          DateTime?   @map("paid_at") @db.Timestamptz(3)
  shippedAt       DateTime?   @map("shipped_at") @db.Timestamptz(3)
  cancelledAt     DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        OrderItem[]
  reservations StockReservation[]
  payments     Payment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid(7)) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  variantId      String @map("variant_id") @db.Uuid
  skuSnapshot    String @map("sku_snapshot")
  nameSnapshot   String @map("name_snapshot")
  unitPriceMinor Int    @map("unit_price_minor")
  quantity       Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([variantId])
  @@map("order_items")
}

model StockReservation {
  id         String            @id @default(uuid(7)) @db.Uuid
  orderId    String            @map("order_id") @db.Uuid
  variantId  String            @map("variant_id") @db.Uuid
  quantity   Int
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  resolvedAt DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([status, expiresAt])
  @@index([variantId, status])
  @@map("stock_reservations")
}

model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String        @unique @map("stripe_session_id")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  amountMinor           Int           @map("amount_minor")
  refundedMinor         Int           @default(0) @map("refunded_minor")
  currency              String        @default("EUR") @db.Char(3)
  idempotencyKey        String        @unique @map("idempotency_key")
  failureReason         String?       @map("failure_reason")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("payments")
}

model StripeWebhookEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  stripeEventId String    @unique @map("stripe_event_id")
  type          String
  receivedAt    DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)

  @@map("stripe_webhook_events")
}

// ───────── Outbox ─────────

model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// Consumer idempotency: one row per (consumer, message), written in the handler's transaction
model ProcessedMessage {
  id          String   @id @default(uuid(7)) @db.Uuid
  consumer    String
  messageId   String   @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@unique([consumer, messageId])
  @@index([processedAt])
  @@map("processed_messages")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid // one login session; rotation keeps the family
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Append-only. No foreign key on purpose: the trail must outlive the users it describes.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorEmail String?  @map("actor_email")
  actorRole  String?  @map("actor_role")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  outcome    String   @default("SUCCESS")
  ip         String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
