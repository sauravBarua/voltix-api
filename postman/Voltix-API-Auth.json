              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator-{{$timestamp}}@voltix.test\",\n  \"name\": \"Postman Operator\",\n  \"password\": \"Operator-Pass-2026!\",\n  \"role\": \"INVENTORY_OPERATOR\"\n}",
