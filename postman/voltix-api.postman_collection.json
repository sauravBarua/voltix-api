          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('non-empty array of categories', () => { pm.expect(body).to.be.an('array').that.is.not.empty; pm.expect(body[0]).to.have.keys('id', 'name', 'slug', 'parentId'); });",
                  "const laptops = body.find(c => c.slug === 'laptops');",
                  "pm.test('seed category laptops exists', () => pm.expect(laptops).to.exist);",
                  "pm.collectionVariables.set('laptopCategoryId', laptops.id);"
                ]
