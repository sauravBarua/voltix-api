          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/users",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Create inventory operator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, operator, no password in the body', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.role).to.eql('INVENTORY_OPERATOR');",
                  "  pm.expect(JSON.stringify(b)).to.not.match(/password/i);",
                  "});",
                  "pm.collectionVariables.set('staffId', pm.response.json().id);"
