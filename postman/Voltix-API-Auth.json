        {
          "name": "Deactivate that user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, inactive', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().isActive).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
