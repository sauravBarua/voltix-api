              "raw": "{ \"isActive\": false }"
            },
            "url": "{{baseUrl}}/api/v1/admin/users/{{staffId}}"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"id\":\"0192f5c4-0000-7000-8000-000000001002\",\"role\":\"INVENTORY_OPERATOR\",\"isActive\":false}"
