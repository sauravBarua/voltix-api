              "code": 403,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":403,\"message\":\"Your role cannot access this resource\",\"error\":\"Forbidden\"}"
            }
          ]
        },
        {
          "name": "List users (403 as customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
