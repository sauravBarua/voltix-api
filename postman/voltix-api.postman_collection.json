        {
          "name": "List products (brand, price, sort)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has items and meta', () => { pm.expect(body.items).to.be.an('array'); pm.expect(body.meta).to.have.keys('page', 'pageSize', 'total', 'totalPages'); });",
                  "pm.test('all items are Apple', () => pm.expect(body.items.every(i => i.brand.slug === 'apple')).to.be.true);",
                  "pm.test('sorted by price asc', () => { const p = body.items.map(i => i.priceFromMinor); pm.expect(p).to.eql([...p].sort((a, b) => a - b)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
