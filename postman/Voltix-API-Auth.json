        {
          "name": "Audit logs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, user.create entry exists, no password stored', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const items = pm.response.json().items;",
                  "  pm.expect(items.some(i => i.action === 'user.create')).to.be.true;",
                  "  pm.expect(JSON.stringify(items)).to.not.match(/password/i);",
                  "});"
