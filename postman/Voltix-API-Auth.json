              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"id\":\"0192f5c4-0000-7000-8000-000000001002\",\"email\":\"operator-1@voltix.test\",\"role\":\"INVENTORY_OPERATOR\",\"isActive\":true}"
