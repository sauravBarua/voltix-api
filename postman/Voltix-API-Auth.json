{
  "info": {
    "name": "Voltix API - Auth (rewritten)",
    "description": "Auth, sessions and admin users. Tokens come from Authorization settings, no pre-request script. Collection default = customerToken, Admin folder = adminToken. Run folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "admin@voltix.test"
    },
    {
      "key": "customerEmail",
      "value": "customer@voltix.test"
    },
    {
      "key": "seedPassword",
      "value": "Voltix-Dev-1234!"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "customerRefreshToken",
      "value": ""
    },
    {
      "key": "oldRefreshToken",
      "value": ""
    },
    {
      "key": "staffId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Public (no token)",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, ADMIN token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.role).to.eql('ADMIN');",
                  "});",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{seedPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"tokenType\":\"Bearer\",\"accessToken\":\"eyJ...\",\"expiresIn\":900,\"refreshToken\":\"Qw8...\",\"user\":{\"id\":\"0192f5c4-0000-7000-8000-000000001000\",\"email\":\"admin@voltix.test\",\"role\":\"ADMIN\",\"isActive\":true}}"
            },
            {
              "name": "401 Invalid email or password",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":401,\"message\":\"Invalid email or password\",\"error\":\"Unauthorized\"}"
            },
            {
              "name": "429 Too many requests",
              "status": "Too Many Requests",
              "code": 429,
              "header": [
                {
                  "key": "Retry-After",
                  "value": "42"
                }
              ],
              "body": "{\"statusCode\":429,\"error\":\"Too Many Requests\",\"message\":\"Too many requests, slow down\",\"retryAfterSeconds\":42}"
            }
          ]
        },
        {
          "name": "Login as customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, CUSTOMER token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.role).to.eql('CUSTOMER');",
                  "});",
                  "pm.collectionVariables.set('customerToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('customerRefreshToken', pm.response.json().refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{seedPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"tokenType\":\"Bearer\",\"accessToken\":\"eyJ...\",\"expiresIn\":900,\"refreshToken\":\"Zk3...\",\"user\":{\"email\":\"customer@voltix.test\",\"role\":\"CUSTOMER\",\"isActive\":true}}"
            },
            {
              "name": "401 Invalid email or password",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":401,\"message\":\"Invalid email or password\",\"error\":\"Unauthorized\"}"
            }
          ]
        },
        {
          "name": "Login (401 wrong password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 with the generic message', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().message).to.eql('Invalid email or password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"{{customerEmail}}\", \"password\": \"Wrong-Password-1!\" }"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "response": []
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, customer, no password in the body', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.user.role).to.eql('CUSTOMER');",
                  "  pm.expect(JSON.stringify(b)).to.not.match(/password/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-{{$timestamp}}@voltix.test\",\n  \"password\": \"Postman-Pass-2026!\",\n  \"name\": \"Postman User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"tokenType\":\"Bearer\",\"accessToken\":\"eyJ...\",\"expiresIn\":900,\"refreshToken\":\"Ab1...\",\"user\":{\"email\":\"postman-1@voltix.test\",\"role\":\"CUSTOMER\",\"isActive\":true}}"
            },
            {
              "name": "400 Weak password or invalid email",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":400,\"message\":\"Validation failed\",\"errors\":[{\"path\":[\"password\"],\"message\":\"at least 10 characters\"}]}"
            },
            {
              "name": "409 Email already registered",
              "status": "Conflict",
              "code": 409,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":409,\"message\":\"A record with the same unique value already exists\"}"
            }
          ]
        },
        {
          "name": "Register (400 weak password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"weak-{{$timestamp}}@voltix.test\", \"password\": \"short\", \"name\": \"Weak\" }"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Session",
      "item": [
        {
          "name": "Me (customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, the customer, no hash', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.role).to.eql('CUSTOMER');",
                  "  pm.expect(b).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"id\":\"01a14546-e11a-72e7-915d-776cc87ff026\",\"email\":\"customer@voltix.test\",\"name\":\"Test Customer\",\"role\":\"CUSTOMER\",\"isActive\":true,\"createdAt\":\"2026-10-17T10:00:00.000Z\"}"
            },
            {
              "name": "401 Missing or expired token",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":401,\"message\":\"Invalid or expired token\",\"error\":\"Unauthorized\"}"
            }
          ]
        },
        {
          "name": "Me (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, the admin', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().role).to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Me (401 no token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
            {
              "name": "401 Missing bearer token",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":401,\"message\":\"Missing bearer token\",\"error\":\"Unauthorized\"}"
            }
          ]
        },
        {
          "name": "Refresh (rotates the token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, a different refresh token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().refreshToken).to.not.eql(pm.collectionVariables.get('customerRefreshToken'));",
                  "});",
                  "pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('customerRefreshToken'));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('customerRefreshToken', pm.response.json().refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"refreshToken\": \"{{customerRefreshToken}}\" }"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
            {
              "name": "401 Unknown, expired or already used",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":401,\"message\":\"Invalid refresh token\",\"error\":\"Unauthorized\"}"
            }
          ]
        },
        {
          "name": "Refresh (401 reuse of the old token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401, and the whole session family is revoked', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"refreshToken\": \"{{oldRefreshToken}}\" }"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 (always)', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"refreshToken\": \"{{customerRefreshToken}}\" }"
            },
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [
            {
              "name": "204 No Content",
              "status": "No Content",
              "code": 204,
              "header": [],
              "body": ""
            }
          ]
        }
      ]
    },
    {
      "name": "3. Admin users and audit (admin token)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "List users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, items and meta, no hashes', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.items).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(b.meta).to.have.keys('page', 'pageSize', 'total', 'totalPages');",
                  "  pm.expect(JSON.stringify(b)).to.not.match(/password/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/users?role=CUSTOMER&pageSize=5"
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"items\":[{\"id\":\"01a14546-e11a-72e7-915d-776cc87ff026\",\"email\":\"customer@voltix.test\",\"role\":\"CUSTOMER\",\"isActive\":true}],\"meta\":{\"page\":1,\"pageSize\":5,\"total\":1,\"totalPages\":1}}"
            },
            {
              "name": "401 No token",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\"statusCode\":401,\"message\":\"Missing bearer token\",\"error\":\"Unauthorized\"}"
            },
            {
              "name": "403 Not an administrator",
